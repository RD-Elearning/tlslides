{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "**/*.test.tsx",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.spec.ts",
    "src/test",
    "dist",
    "docs"
  ],
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // See packages/tldraw/tsconfig.build.json for why this override exists: without it, lask's
    // esbuild step inherits tsconfig.base.json's "jsx": "preserve" and ships raw JSX in dist.
    "jsx": "react"
  }
}
