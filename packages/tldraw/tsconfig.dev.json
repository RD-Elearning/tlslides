{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "**/*.test.tsx",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.spec.ts",
    "src/test",
    "dist",
    "docs"
  ],
  "compilerOptions": {
    "skipLibCheck": true,
    "composite": false,
    "incremental": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Keep dev (watch-mode) output transpiled the same way as the production build — see the
    // comment in tsconfig.build.json for why this override exists at all.
    "jsx": "react"
  }
}
