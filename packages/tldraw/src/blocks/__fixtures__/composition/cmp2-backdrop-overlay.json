{
  "id": "cmp2-backdrop-overlay",
  "slides": [
    {
      "id": "c2_photo",
      "layout": "full-bleed",
      "regions": {
        "content": [
          {
            "id": "img",
            "type": "tls.m.image",
            "props": {
              "src": "data:image/jpeg;base64,",
              "alt": "Team at work",
              "fit": "cover"
            },
            "layer": "backdrop"
          },
          {
            "id": "kick",
            "type": "tls.t.kicker",
            "props": {
              "text": "Annual review"
            },
            "layer": "overlay",
            "anchor": "top-left",
            "style": {
              "padding": "xl",
              "accent": "text"
            }
          },
          {
            "id": "big",
            "type": "tls.t.title",
            "props": {
              "text": "A year of building together",
              "size": "display"
            },
            "layer": "overlay",
            "anchor": "bottom-left",
            "style": {
              "padding": "xl"
            }
          }
        ]
      }
    },
    {
      "id": "c2_overlay",
      "layout": "two-column",
      "regions": {
        "title": [
          {
            "id": "t2",
            "type": "tls.t.title",
            "props": {
              "text": "Text placed on a photo inside one block"
            }
          }
        ],
        "left": [
          {
            "id": "ov",
            "type": "tls.l.overlay",
            "props": {
              "children": [
                {
                  "id": "ov_img",
                  "type": "tls.m.image",
                  "props": {
                    "src": "data:image/jpeg;base64,",
                    "alt": "Photo",
                    "fit": "cover"
                  },
                  "layer": "backdrop"
                },
                {
                  "id": "ov_card",
                  "type": "tls.l.card",
                  "props": {
                    "padding": "md",
                    "children": [
                      {
                        "id": "ov_b",
                        "type": "tls.t.body",
                        "props": {
                          "text": "Caption card anchored bottom-left"
                        }
                      }
                    ]
                  },
                  "anchor": "bottom-left",
                  "style": {
                    "tone": "inverted",
                    "radius": "md"
                  }
                },
                {
                  "id": "ov_kick",
                  "type": "tls.t.kicker",
                  "props": {
                    "text": "Field study"
                  },
                  "anchor": "top-right",
                  "style": {
                    "accent": "text"
                  }
                }
              ]
            }
          }
        ],
        "right": [
          {
            "id": "r1",
            "type": "tls.t.body",
            "props": {
              "text": "The overlay places each child at its anchor: the photo fills the box behind (layer backdrop), the caption card sits bottom-left at its natural size and the kicker top-right."
            }
          }
        ]
      }
    },
    {
      "id": "c2_bleed",
      "layout": "blank",
      "regions": {
        "content": [
          {
            "id": "st",
            "type": "tls.t.statement",
            "props": {
              "text": "Decoration may leave the frame on purpose."
            }
          }
        ]
      },
      "free": [
        {
          "block": {
            "id": "orb",
            "type": "tls.m.decoration",
            "props": {
              "shape": "blob",
              "tone": "accent2",
              "opacity": "soft",
              "seed": 7
            },
            "layer": "backdrop",
            "bleed": true
          },
          "box": {
            "x": 1480,
            "y": -160,
            "width": 600,
            "height": 600
          }
        }
      ]
    }
  ]
}
