            "motion": {
              "preset": "fade-up",
              "order": 1
            }
          }
        ],
        "timeline": [
          {
            "id": "b_05_fill-blank",
            "type": "tls.a.fill-blank",
            "props": {
              "prompt": "Fill in the blanks",
              "text": "The [[median]] is the middle value, while the [[mean]] is the sum divided by the count.",
              "distractors": [
                "mode"
              ]
            },
            "motion": {
              "preset": "fade-up",
              "order": 2
            }
          }
        ]
      }
