            "type": "tls.a.match",
            "props": {
              "prompt": "Match each term with its meaning",
              "pairs": [
                {
                  "left": "Mean",
                  "right": "Sum divided by the count"
                },
                {
                  "left": "Median",
                  "right": "Middle value of the ordered data"
                },
                {
                  "left": "Mode",
                  "right": "Most frequent value"
                }
              ]
            },
            "motion": {
              "preset": "fade-up",
              "order": 2
            }
          }
        ]
      }
    },
