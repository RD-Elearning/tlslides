          }
        ],
        "timeline": [
          {
            "id": "b2",
            "type": "tls.t.bullets",
            "props": {
              "items": [
                { "text": "Q1: Research and prototyping" },
                { "text": "Q2: Alpha release to internal teams" },
                { "text": "Q3: Beta with 50 customers" },
                { "text": "Q4: General availability" }
              ],
              "marker": "number",
              "spacing": "lg"
            }
          }
        ]
      }
    }
  ]
}
