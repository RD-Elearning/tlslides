{
  "version": 1,
  "id": "golden-timeline",
  "title": "Timeline Deck",
  "theme": "mono-grid",
  "aspect": "widescreen",
  "slides": [
    {
      "id": "sl_01",
      "layout": "timeline",
      "role": "content",
